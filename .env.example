# Cơ sở dữ liệu (docker compose — cổng 5436)
DATABASE_URL="postgresql://gospeak:gospeak_dev_password@localhost:5436/gospeak?schema=public"

# Auth.js — tạo bằng: npx auth secret
AUTH_SECRET="doi-chuoi-nay-khi-chay-that"

# MinIO — lưu file ghi âm bài nói, ảnh bài viết, ảnh câu hỏi
MINIO_ENDPOINT="localhost"
MINIO_PORT="9300"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="gospeak"
MINIO_SECRET_KEY="gospeak_dev_password"
MINIO_BUCKET="gospeak-files"

# Bản demo: hiện nút tài khoản dùng thử ở trang đăng nhập. Bản chạy thật: false
DEMO_ACCOUNTS="true"
DEMO_PASSWORD="123456"
