# Caddy tự xin và gia hạn chứng chỉ HTTPS (Let's Encrypt) cho hai tên miền.
# Tên miền lấy từ biến APP_DOMAIN / FILES_DOMAIN trong .env.production.

{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}

# Gõ www thì chuyển về tên miền chính (cần bản ghi DNS www trỏ cùng IP)
www.{$APP_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

# File ghi âm, ảnh vở, ảnh câu hỏi — trình duyệt đọc/ghi thẳng bằng URL có chữ ký.
{$FILES_DOMAIN} {
	request_body {
		max_size 50MB
	}
	reverse_proxy minio:9000 {
		# Chữ ký S3 tính theo Host — giữ nguyên Host mà trình duyệt gửi
		header_up Host {host}
	}
}
