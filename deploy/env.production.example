# Trên server: chép thành file .env ở thư mục gốc dự án rồi điền mật khẩu.
#   cp deploy/env.production.example .env
# Tạo chuỗi ngẫu nhiên:  openssl rand -hex 24
# File .env không được đưa lên GitHub (.gitignore đã chặn).

APP_DOMAIN=abcd.io.vn
FILES_DOMAIN=files.abcd.io.vn

# Mật khẩu chỉ gồm chữ và số (không dùng @ : / # vì nằm trong chuỗi kết nối DATABASE_URL)
POSTGRES_PASSWORD=doi-thanh-chuoi-ngau-nhien
MINIO_PASSWORD=doi-thanh-chuoi-ngau-nhien-it-nhat-8-ky-tu
AUTH_SECRET=doi-thanh-chuoi-ngau-nhien

# Bản demo cho trung tâm xem: true (hiện nút tài khoản dùng thử). Chạy thật: false
DEMO_ACCOUNTS=true
DEMO_PASSWORD=123456
